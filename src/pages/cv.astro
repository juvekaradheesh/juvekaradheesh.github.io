---
import Layout from '@/layouts/Layout.astro';
import { experiences, education, publications } from '@/data/cv';
import CvTimeline from '@/components/ui/CvTimeline.astro';
import PublicationsList from '@/components/ui/PublicationsList.astro';
---
<Layout title="CV | Adheesh Juvekar">
  <div class="cv-page">
    <header class="cv-header">
      <p class="eyebrow">Curriculum vitae</p>
      <h1>Adheesh Juvekar</h1>
      <p class="subtitle">Ph.D. Student · Computer Science</p>
      <p class="affiliation">University of Illinois Urbana-Champaign · PLAN Lab</p>
      <p class="intro">I study how models connect language with visual evidence for multimodal reasoning, generation, and editing.</p>
      <div class="header-links"><a href="mailto:adheesh2@illinois.edu">Email ↗</a><a href="https://plan-lab.github.io/">PLAN Lab ↗</a></div>
    </header>
    <nav class="cv-nav" aria-label="CV sections">
      <a href="#education">Education</a><a href="#industry">Industry</a><a href="#research">Research</a><a href="#publications">Publications</a><a href="#teaching-service">Teaching & service</a>
    </nav>
    <section id="education"><h2><span>01</span> Education</h2><CvTimeline elements={education} /></section>
    <section id="industry"><h2><span>02</span> Industry experience</h2><CvTimeline elements={experiences.filter(e => e.category === 'Industry')} /></section>
    <section id="research"><h2><span>03</span> Research experience</h2><CvTimeline elements={experiences.filter(e => e.category === 'Research')} /></section>
    <section id="publications"><h2><span>04</span> Publications & preprints <small>{publications.length}</small></h2><PublicationsList elements={publications} /></section>
    <section id="teaching-service">
      <h2><span>05</span> Teaching & service</h2>
      <div class="service-grid">
        <article><h3>Teaching</h3><h4>Graduate Teaching Assistant · Virginia Tech</h4><p>2020–2022 · Machine Learning with Big Data, Mobile Application Development, Web Application Development, and Introduction to Software Design.</p><h4>Guest lecture · Advanced Machine Learning</h4><p>Spring 2023 · Diffusion Models.</p></article>
        <article><h3>Academic service</h3><h4>Conference reviewer</h4><p>AAAI 2026, 2027 · WACV 2027 · NeurIPS 2026 · ECCV 2026 · ACL 2026 · CVPR 2026 · EMNLP 2022 · PETRA 2023, 2024.</p><h4>PLAN Lab website</h4><p>Co-developed the <a href="https://plan-lab.github.io/">PLAN Lab website ↗</a>.</p></article>
      </div>
    </section>
  </div>
</Layout>
<style>
  .cv-page { color: #263040; }
  .cv-header { padding: 2.25rem; border-radius: 1rem; background: #f3f5f8; border-top: 4px solid #d57236; }
  .eyebrow { font-size: .72rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: #915022; margin-bottom: 1rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 750; letter-spacing: -.04em; line-height: 1.2; }
  .subtitle { margin-top: .8rem; font-size: 1.1rem; font-weight: 600; }
  .affiliation { margin-top: .35rem; font-size: .9rem; color: #526074; }
  .intro { max-width: 39rem; margin-top: 1.2rem; line-height: 1.8; color: #526074; }
  .header-links { display: flex; gap: 1.5rem; margin-top: 1.25rem; font-size: .8rem; font-weight: 600; }
  .cv-nav { display: flex; flex-wrap: wrap; gap: .6rem 1.5rem; padding: 1.4rem 0; margin-bottom: 1.5rem; border-bottom: 1px solid #e5e7eb; font-size: .8rem; color: #526074; }
  a:hover { color: #a64a18; text-decoration: underline; text-underline-offset: 4px; }
  section { margin-bottom: 3.5rem; scroll-margin-top: 2rem; }
  h2 { display: flex; align-items: baseline; gap: .75rem; font-size: 1.45rem; font-weight: 700; margin-bottom: 1.4rem; letter-spacing: -.025em; }
  h2 span { color: #ac633b; font-size: .75rem; font-weight: 500; letter-spacing: .04em; }
  h2 small { margin-left: auto; font-size: .85rem; font-weight: 500; color: #697386; }
  .service-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
  .service-grid article { padding: 1.5rem; background: #f3f5f8; border-radius: .8rem; }
  h3 { font-weight: 700; font-size: 1.1rem; }
  h4 { font-weight: 600; font-size: .85rem; margin-top: 1rem; }
  .service-grid p { color: #526074; margin-top: .5rem; font-size: .85rem; line-height: 1.8; }
  @media (max-width: 600px) { .cv-header { padding: 1.5rem; } .service-grid { grid-template-columns: 1fr; } }
</style>
