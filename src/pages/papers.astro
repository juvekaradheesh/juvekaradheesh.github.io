---
import Layout from '@/layouts/Layout.astro';
import { publications } from '@/data/cv';
import PublicationCard from '@/components/ui/PublicationCard.astro';
const displayedPapers = publications
  .filter(paper => paper.image || paper.journal.includes('Accepted'))
  .map(paper => ({
    ...paper,
    journal: ['Submitted', 'arXiv preprint'].includes(paper.journal) ? 'Preprint' : paper.journal,
  }));
---
<Layout title="Publications | Adheesh Juvekar">
  <section>
    <header class="mb-4 border-b pb-8">
      <p class="text-sm uppercase tracking-widest text-base-content/60 mb-3">Research</p>
      <h1 class="text-4xl font-bold mb-4">Publications & preprints</h1>
      <p class="text-base-content/70">Multimodal reasoning, grounded understanding, and controllable visual generation.</p>
    </header>
    <div>{displayedPapers.map(paper => <PublicationCard paper={paper} detailed />)}</div>
  </section>
</Layout>
