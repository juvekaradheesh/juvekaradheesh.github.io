---
import type { Publication } from '@/types/cv';
import { highlightAuthor } from '@/lib/utils';
import { template } from '@/settings';
import GitHub from '@/assets/social-icons/github.svg';
import Document from '@/assets/icons/document.svg';
import Globe from '@/assets/icons/globe.svg';
interface Props { paper: Publication; detailed?: boolean; }
const { paper, detailed = false } = Astro.props;
const primaryLink = paper.link || paper.paperLink;
const pending = ['Submitted', 'In preparation', 'arXiv preprint', 'Preprint'].includes(paper.journal);
---
<article class:list={['publication', { detailed }]}>
  {detailed && paper.image && <a href={primaryLink} class="paper-image" tabindex="-1" aria-hidden="true">
    <img src={`${template.base}${paper.image}`} alt="" loading="lazy" decoding="async" />
  </a>}
  <div class="paper-content">
    <div class="paper-meta">
      <span class:list={['venue', { pending }]}>{paper.journal}</span>
      {!paper.journal.includes(paper.time) && <span class="year">{paper.time}</span>}
    </div>
    <h3>{primaryLink ? <a href={primaryLink}>{paper.title}</a> : paper.title}</h3>
    <p class="authors"><span set:html={highlightAuthor(paper.authors)} /></p>
    {paper.notes && <p class="notes">{paper.notes}</p>}
    <div class="paper-links">
      {paper.paperLink && <a href={paper.paperLink}><Document width="16" height="16" aria-hidden="true" />Paper <span aria-hidden="true">↗</span></a>}
      {paper.link && <a href={paper.link}>
        {paper.paperLink ? <Globe width="16" height="16" aria-hidden="true" /> : <Document width="16" height="16" aria-hidden="true" />}
        {paper.paperLink ? 'Project' : 'Paper'} <span aria-hidden="true">↗</span>
      </a>}
      {paper.codeLink && <a href={paper.codeLink}><GitHub width="16" height="16" fill="currentColor" aria-hidden="true" />Code <span aria-hidden="true">↗</span></a>}
    </div>
    {detailed && paper.abstract && <details class="abstract">
      <summary>Abstract</summary>
      <p>{paper.abstract}</p>
    </details>}
  </div>
</article>
<style>
  .publication { padding: 1.6rem 0; border-bottom: 1px solid color-mix(in srgb, currentColor 12%, transparent); }
  .publication.detailed { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; padding: 1.75rem 0; }
  .paper-content { min-width: 0; }
  .paper-meta { display: flex; flex-wrap: wrap; align-items: center; gap: .65rem; margin-bottom: .65rem; font-size: .75rem; }
  .venue { padding: .25rem .6rem; border-radius: .35rem; background: #e9f0fb; color: #24456e; font-weight: 700; }
  .venue.pending { background: #f3f0e9; color: #625336; }
  .year, .notes { opacity: .65; }
  h3 { font-size: 1.08rem; line-height: 1.5; font-weight: 700; margin: 0 0 .6rem; }
  h3 a:hover, .paper-links a:hover { color: #a64a18; text-decoration: underline; text-underline-offset: 3px; }
  .authors { font-size: .875rem; line-height: 1.75; opacity: .85; }
  .notes { margin-top: .3rem; font-size: .75rem; }
  .paper-links { display: flex; flex-wrap: wrap; gap: 1.1rem; margin-top: .75rem; font-size: .8rem; font-weight: 600; }
  .paper-links:empty { display: none; }
  .paper-links a { display: inline-flex; align-items: center; gap: .35rem; }
  .paper-image { align-self: start; display: flex; align-items: center; justify-content: center; padding: .6rem; background: white; border: 1px solid #e6e9ee; border-radius: .75rem; overflow: hidden; aspect-ratio: 16 / 10; }
  .paper-image img { width: 100%; height: 100%; object-fit: contain; }
  .abstract { margin-top: .85rem; font-size: .85rem; line-height: 1.75; }
  summary { width: fit-content; cursor: pointer; font-weight: 600; }
  .abstract p { margin-top: .6rem; opacity: .8; }
  @media (min-width: 768px) { .detailed:has(.paper-image) { grid-template-columns: 250px minmax(0, 1fr); } }
</style>
