---
import type { Publication } from '@/types/cv';
import PublicationCard from './PublicationCard.astro';
interface Props { listTitle: string; listItems: Publication[]; }
const { listTitle, listItems } = Astro.props;
---
<h2 class="text-3xl font-bold mb-4">{listTitle}</h2>
<div>{listItems.map(paper => <PublicationCard paper={paper} />)}</div>
