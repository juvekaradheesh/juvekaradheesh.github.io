---
import { isSkill } from '@/types/cv';
import type { Skill, Publication } from '@/types/cv';
import { highlightAuthor } from '@/lib/utils'

interface Props {
	elements: (Skill | Publication)[]
}

const { elements } = Astro.props
---
<ul class='space-y-8'>
  {elements.map((element, index) => (
    <li class='group'>
      { isSkill(element)
        ? <>
        <h3 class='text-lg font-bold mb-2'>{element.title}</h3>
        <p>{element.description}</p>
        </> : <>
      <a
        href={element.link as string}
        class='block hover:text-accent transition-colors duration-200'
        target='_blank'
      >
        <h3 class='text-lg font-bold mb-2'>{element.title}</h3>
      </a>
      <p class='text-base mb-2'>
        <span
          set:html={highlightAuthor(element.authors as string)}
        />
      </p>
      <p class='text-sm mb-3'>
        <span class='italic'>{element.journal}</span> •{' '}
        {element.time}
      </p>
      <div class="abstract-container">
        <p class="abstract-text" data-full={element.abstract}>{element.abstract?.slice(0, 200)}{element.abstract && element.abstract.length > 200 ? '... ' : ''}{element.abstract && element.abstract.length > 200 && <button class="read-more-btn text-sm text-accent underline" onclick="toggleAbstract(this)">Read more</button>}</p>
      </div>
      {element.notes && <p class="text-sm mt-2">{element.notes}</p>}
      </>
    }
    {/* Uncomment this line to add a small border bottom for each element
    {index !== elements.length -1 && <hr class="mt-6 border-primary/40" />}  */}
    </li>
  ))}
</ul>
<script client:load>
  function toggleAbstract(button) {
    const textElement = button.parentElement;
    const fullAbstract = textElement.dataset.full;
    if (button.textContent === 'Read more') {
      textElement.innerHTML = fullAbstract + ' <button class="read-more-btn text-sm text-accent underline" onclick="toggleAbstract(this)">Read less</button>';
    } else {
      textElement.innerHTML = fullAbstract.slice(0, 200) + '... <button class="read-more-btn text-sm text-accent underline" onclick="toggleAbstract(this)">Read more</button>';
    }
  }
</script>
