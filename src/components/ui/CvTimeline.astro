---
import { isExperience } from '@/types/cv';
import type { Experience, Education } from '@/types/cv';
import { template } from '@/settings';
interface Props { elements: (Experience | Education)[]; }
const { elements } = Astro.props;
---
<ul class="cv-entries">
  {elements.map(element => <li class="cv-entry">
    <div class="logo-box">
      {element.logo && <img src={`${template.base}${element.logo}`} alt="" loading="lazy" />}
    </div>
    <div class="entry-body">
      <div class="entry-heading">
        <h3>{isExperience(element) ? element.title : element.degree}</h3>
        <span class="entry-time">{element.time}</span>
      </div>
      <p class="organization">{isExperience(element) ? element.company : element.school}</p>
      {element.location && <p class="location">{element.location}</p>}
      {element.description && <p class="description">{element.description}</p>}
    </div>
  </li>)}
</ul>
<style>
  .cv-entries { display: grid; gap: 1rem; }
  .cv-entry { display: flex; align-items: flex-start; gap: 1.1rem; padding: 1.5rem; border: 1px solid #e5e7eb; border-radius: .8rem; background: #fff; color: #263040; }
  .logo-box { display: flex; justify-content: center; align-items: center; width: 60px; height: 60px; flex: 0 0 60px; padding: 6px; }
  .logo-box img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .entry-body { flex: 1; min-width: 0; }
  .entry-heading { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .4rem 1rem; align-items: baseline; }
  h3 { font-size: 1.05rem; font-weight: 700; }
  .entry-time { color: #735337; font-size: .75rem; font-weight: 600; }
  .organization { margin-top: .35rem; font-size: .9rem; font-weight: 500; }
  .location { margin-top: .25rem; color: #697386; font-size: .75rem; }
  .description { margin-top: .75rem; font-size: .875rem; line-height: 1.75; color: #536071; }
  @media (max-width: 540px) { .cv-entry { padding: 1rem; gap: .75rem; } .logo-box { width: 38px; height: 44px; flex-basis: 38px; padding: 2px; } }
</style>
